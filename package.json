{
  "name": "Rescue-Paws",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "lint": "expo lint"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@clerk/clerk-expo": "^2.1.1",
    "@expo/config-plugins": "~9.0.0",
    "@expo/html-elements": "^0.10.1",
    "@expo/metro-runtime": "~4.0.0",
    "@expo/vector-icons": "^14.0.2",
    "@fortawesome/fontawesome-svg-core": "^6.6.0",
    "@fortawesome/free-brands-svg-icons": "^6.6.0",
    "@fortawesome/free-regular-svg-icons": "^6.6.0",
    "@fortawesome/free-solid-svg-icons": "^6.6.0",
    "@fortawesome/react-native-fontawesome": "^0.3.2",
    "@react-native-firebase/app": "^21.7.0",
    "@react-native-firebase/messaging": "^21.7.0",
    "@react-native-picker/picker": "2.9.0",
    "@react-navigation/native": "^7.0.14",
    "assert": "^2.1.0",
    "date-fns": "^3.6.0",
    "expo": "^52.0.25",
    "expo-auth-session": "~6.0.2",
    "expo-constants": "~17.0.4",
    "expo-dev-client": "~5.0.9",
    "expo-device": "~7.0.2",
    "expo-font": "~13.0.3",
    "expo-image-picker": "~16.0.4",
    "expo-linear-gradient": "~14.0.2",
    "expo-linking": "~7.0.4",
    "expo-local-authentication": "~15.0.2",
    "expo-location": "~18.0.5",
    "expo-notifications": "~0.29.12",
    "expo-router": "~4.0.16",
    "expo-secure-store": "~14.0.1",
    "expo-splash-screen": "~0.29.20",
    "expo-status-bar": "~2.0.1",
    "expo-system-ui": "~4.0.7",
    "expo-updates": "~0.26.12",
    "expo-web-browser": "~14.0.2",
    "express": "^4.21.2",
    "firebase": "^10.13.0",
    "firebase-admin": "^13.0.2",
    "firebase-functions": "^6.2.0",
    "google-auth-library": "^9.15.0",
    "groq-sdk": "^0.7.0",
    "moment": "^2.30.1",
    "nativewind": "^2.0.11",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.6",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-get-random-values": "~1.11.0",
    "react-native-gifted-chat": "^2.6.2",
    "react-native-keyboard-spacer": "^0.4.1",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "^4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~18.3.12",
    "@types/react-dom": "~18.3.1",
    "@types/react-test-renderer": "^18.0.7",
    "jest": "^29.2.1",
    "jest-expo": "~52.0.3",
    "react-test-renderer": "18.2.0",
    "tailwindcss": "^3.3.2",
    "typescript": "~5.3.3"
  },
  "expo": {
    "name": "Pet Adoption",
    "slug": "pet-adoption",
    "version": "1.0.0",
    "sdkVersion": "42.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.petadoption",
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to scan barcodes.",
        "NSLocationWhenInUseUsageDescription": "This app uses your location to find nearby places.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to upload images.",
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.yourcompany.petadoption",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#000000",
      "iosDisplayInForeground": true
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@fortawesome/fontawesome-svg-core",
          "@fortawesome/free-brands-svg-icons",
          "@fortawesome/free-regular-svg-icons",
          "@fortawesome/free-solid-svg-icons",
          "react-native-keyboard-spacer"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "private": true
}
